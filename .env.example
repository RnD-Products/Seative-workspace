# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Used ONLY by the CEO "add member" action and the demo seed script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Anthropic (optional: the app works without it, AI features show as unavailable) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Per-user AI request limit (requests per 10 minutes)
AI_RATE_LIMIT=20
